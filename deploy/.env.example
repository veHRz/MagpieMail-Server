# Copy to deploy/.env (or run `task dev:env`, which also generates the password).
# deploy/.env is ignored by git: never commit it.
#
# These variables configure docker compose, not the server: the MAGPIE_ prefix
# is reserved for server settings, hence MAGPIEMAIL_.

# PostgreSQL password, used by both containers. Use letters and digits only.
MAGPIEMAIL_DB_PASSWORD=change-me

# Host port of the API, published on 127.0.0.1 only.
# MAGPIEMAIL_HTTP_PORT=8080

# Image to run. Defaults to a local build of the repository.
# MAGPIEMAIL_IMAGE=magpiemail-server:dev
